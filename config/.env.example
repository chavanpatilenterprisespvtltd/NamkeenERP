APP_ENV=staging
APP_NAME=namkeen-erp
APP_VERSION=v90.gx
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=namkeen_erp
POSTGRES_USER_FILE=/run/secrets/postgres_user
POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
DATABASE_URL_FILE=/run/secrets/database_url
JWT_SECRET_FILE=/run/secrets/jwt_secret
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=namkeen-private
OBJECT_STORAGE_ACCESS_KEY_FILE=/run/secrets/object_storage_access_key
OBJECT_STORAGE_SECRET_KEY_FILE=/run/secrets/object_storage_secret_key
NOTIFICATION_PROVIDER=stub
NOTIFICATION_API_KEY_FILE=/run/secrets/notification_api_key
TALLY_BASE_URL=
TALLY_COMPANY_NAME=
TALLY_SECRET_FILE=/run/secrets/tally_secret
GST_IRP_BASE_URL=
GST_IRP_SECRET_FILE=/run/secrets/gst_irp_secret
EWB_BASE_URL=
EWB_SECRET_FILE=/run/secrets/ewb_secret
TLS_ENFORCE=true
RATE_LIMIT_PER_MINUTE=120
BACKUP_REQUIRED_BEFORE_MIGRATION=true
# [Session CS2] V90.gx settings
RUN_MIGRATIONS=true
DEMO_LOGIN_ENABLED=false
ERP_ADMIN_PASSWORD_FILE=
NOTIFICATION_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD_FILE=
SMTP_FROM=
SMTP_STARTTLS=true
ERP_ALERT_EMAIL=
FSSAI_ALERT_DAYS=60
OIL_TPM_LIMIT_PCT=25
BUSINESS_DATE_MAX_BACKDATE_DAYS=7
WORKER_POLL_SECONDS=30
